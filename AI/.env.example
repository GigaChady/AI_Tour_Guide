# Application mode
# true  -> mock responses, no external geocoding or LLM calls
# false -> live narration pipeline
AI_MOCK=true
AI_RUN_STREAM_WORKER=true

# Redis narration worker
REDIS_URL=redis://redis:6379/0
AI_STREAM_KEY=location:events
AI_PUBSUB_PREFIX=tour:
AI_STREAM_BLOCK_MS=5000
AI_STREAM_COUNT=10
REDIS_PREF_CACHE=preferences:

# Narration defaults
DEFAULT_DETAIL_LEVEL=18
DEFAULT_SEARCH_RADIUS=2500
DEFAULT_LANGUAGE=pl
DEFAULT_LANGUAGE_NAME=Polish
MAX_NARRATION_LENGTH=500

# Nominatim
NOMINATIM_USER_AGENT=AI-Tour-Guide/0.1 (contact: your-email@example.com)
NOMINATIM_TIMEOUT_SECONDS=10

# Overpass
OVERPASS_TIMEOUT_SECONDS=12
OVERPASS_MAX_RETRIES=2

# Wikimedia
WIKIMEDIA_USER_AGENT=AI-Tour-Guide/0.1 (contact: your-email@example.com)
WIKIMEDIA_TIMEOUT_SECONDS=8
WIKIMEDIA_LANGUAGES=["pl","en","de"]
WIKIMEDIA_MAX_EXTRACT_CHARS=30000

# NVIDIA language model used by the default live pipeline
NVIDIA_API_KEY=
CLOUD_NARRATIVE_MODEL_NAME=meta/llama-3.3-70b-instruct
CLOUD_NARRATIVE_TEMPERATURE=0.3
CLOUD_NARRATIVE_TOP_P=0.9
CLOUD_NARRATIVE_MAX_TOKENS=700
CLOUD_NARRATIVE_REQUEST_TIMEOUT_SECONDS=45
CLOUD_NARRATIVE_MAX_RETRIES=2
CLOUD_NARRATIVE_RETRY_BACKOFF_SECONDS=2.0

# Optional Ollama adapters (not used by the default pipeline)
OLLAMA_MODEL=mistral-nemo
FILTERING_OLLAMA_BASE_URL=http://ollama:11434
FILTERING_OLLAMA_MODEL_NAME=mistral-nemo
NARRATIVE_OLLAMA_BASE_URL=http://ollama:11434
NARRATIVE_OLLAMA_MODEL_NAME=mistral-nemo

# MinIO image storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin12345
MINIO_BUCKET=poi-images
MINIO_SECURE=false

PYTHONUNBUFFERED=1
